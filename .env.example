# Copie este arquivo para .env e preencha fora do Git.
# config.settings.local lê esse arquivo e não substitui variáveis já definidas.
# Valores sem aspas. Este exemplo não contém senha nem chave real.

DJANGO_SECRET_KEY=

# Banco local exclusivo do AP Cluster. O servidor ainda não está instalado.
# Não usar banco do SGS-Gelosar, Railway, Render ou produção.
POSTGRES_DB=apcluster
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Superusuário do servidor local. A aplicação não usa esta conta.
POSTGRES_SUPERUSER=
POSTGRES_SUPERUSER_PASSWORD=

# No Railway, RAILWAY_ENVIRONMENT seleciona config.settings.production.
# Não defina DJANGO_SETTINGS_MODULE=config.settings.local nesse serviço.
# A produção exige DJANGO_SECRET_KEY, POSTGRES_DB, POSTGRES_USER,
# POSTGRES_PASSWORD e POSTGRES_HOST. POSTGRES_PORT segue opcional.
# DJANGO_ALLOWED_HOSTS é opcional quando RAILWAY_PUBLIC_DOMAIN existe.
